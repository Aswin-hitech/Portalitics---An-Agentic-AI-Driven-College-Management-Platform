APP_NAME=Portalitics
APP_ENV=development
APP_SECRET_KEY=<REPLACE_WITH_A_STRONG_RANDOM_HEX_KEY>
APP_PORT=8000

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=portalitics_db

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=portalitics-ai

AT_RISK_ATTENDANCE_THRESHOLD=75.0
AT_RISK_GRADE_DROP_PERCENT=15.0
RISK_WEIGHT_ATTENDANCE=0.3
RISK_WEIGHT_GRADES=0.3
RISK_WEIGHT_ASSIGNMENTS=0.2
RISK_WEIGHT_SUBMISSION_DELAYS=0.2

AT_RISK_SUPPORT_THRESHOLD=30.0
AT_RISK_IMMEDIATE_THRESHOLD=55.0

INTERVENTION_EVALUATION_WINDOW_DAYS=14
